<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Type de service de premier plan (Android 14+). dataSync : l'app
         synchronise des AGRÉGATS d'usage ; sert aussi d'indicateur permanent. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- LOT 3 — Localisation : service de premier plan de type `location`
         (Android 14+) + permissions de position fine/approchée. La notification
         de supervision persistante (K1) rend ce suivi TOUJOURS visible : aucune
         géolocalisation occulte (docs/02-CONFORMITE.md). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- LOT 4 — Filtrage réseau : VpnService LOCAL (sinkhole DNS). Le service de
         premier plan est de type `specialUse` (il n'y a pas de type `vpn` dédié) ;
         justification = filtrage de contenu par contrôle parental, trafic LOCAL,
         AUCUN MITM. Voir docs/09-LOT4-FILTRAGE.md (déclaration Play). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Localisation en arrière-plan : permission SENSIBLE (formulaire Play +
         vidéo de démo « child_monitoring »). Demandée au runtime UNIQUEMENT si
         BuildConfig.FEATURE_BACKGROUND_LOCATION est actif (voir build.gradle.kts).
         Pour publier une variante sans arrière-plan en cas de refus Play,
         retirer aussi cette ligne (ou la placer dans un product flavor). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- LOT 2 — Application des règles en mode Standard : overlay de blocage
         VISIBLE au-dessus de l'app au premier plan (SYSTEM_ALERT_WINDOW).
         Accordée explicitement par l'utilisateur (Réglages → Affichage par-dessus
         les autres apps). L'overlay informe et propose « demander + de temps » et
         l'appel d'urgence (112) ; il n'emprisonne pas l'enfant. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Faire sonner l'appareil même en silencieux (commande « sonner », V15). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Temps d'écran : accès aux statistiques d'usage (permission SPÉCIALE,
         accordée par l'enfant/parent via Réglages → Accès aux données d'usage).
         Elle n'est pas demandée via le runtime : on redirige vers les Réglages. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Journal d'appels : MÉTADONNÉES uniquement (qui/quand/durée), jamais le
         contenu. Permission SENSIBLE : la collecte est désactivée par défaut
         (BuildConfig.FEATURE_CALL_LOG) et conditionnée au consentement explicite.
         Déclaration Play à fournir (usage « core » de supervision transparente). -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Inventaire des apps : on évite QUERY_ALL_PACKAGES. LauncherApps liste les
         apps LANÇABLES sans permission large ; <queries> ci-dessous couvre la
         résolution de libellés/catégories des apps à interface de lancement. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_lock_lock"
        android:theme="@style/Theme.ControleParental"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service de supervision : notification persistante (transparence) +
             déclenchement de la collecte d'agrégats. -->
        <service
            android:name=".service.SupervisionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location" />

        <!-- LOT 4 — VpnService LOCAL de filtrage DNS (sinkhole). Rôle « core » :
             trafic LOCAL, aucun MITM, aucun proxy distant (docs/09-LOT4-FILTRAGE.md).
             Protégé par BIND_VPN_SERVICE ; le consentement VpnService.prepare est
             demandé à l'utilisateur (toujours visible, icône clé + notification). -->
        <service
            android:name=".filter.LocalDnsVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Filtrage de contenu par contrôle parental : résolveur DNS local (sinkhole), sans MITM ni proxy distant." />
        </service>

        <!-- LOT 6 — Analyse de bien-être/sécurité ON-DEVICE (profil ado).
             NotificationListenerService : capte le texte des notifications pour
             l'analyser SUR L'APPAREIL (moteur pur) et n'émettre que des SIGNAUX de
             métadonnées (catégorie/gravité/app) — JAMAIS le contenu (ligne rouge,
             docs/11-LOT6-BIEN-ETRE.md). Le service est LIÉ PAR LE SYSTÈME quand
             l'ado accorde l'accès aux notifications (Réglages → Accès aux
             notifications) ; on ne le force jamais. Protégé par
             BIND_NOTIFICATION_LISTENER_SERVICE (le système est le seul autorisé à
             le lier). Pas de foregroundServiceType (service lié, pas un FGS).
             PIÈGE Android 13+ « paramètres restreints » : pour une app SIDELOADÉE
             (hors store), l'accès aux notifications est bloqué tant que l'ado n'a
             pas fait « Autoriser les paramètres restreints » depuis Infos de
             l'application (voir docs/10-INSTALLATION.md). -->
        <service
            android:name=".safety.SafetyNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- LOT 3 — Réception des transitions de geofence (ENTER/EXIT/DWELL).
             Déclenché par les services Google Play ; non exporté aux autres apps. -->
        <receiver
            android:name=".location.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Relance la supervision + le filtrage après un redémarrage OU une mise à
             jour de l'app (MY_PACKAGE_REPLACED, livré uniquement à l'app remplacée —
             aucun filtre de données requis). -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- LOT 2 — Administrateur d'appareil : verrouillage instantané visible
             (lockNow). En device owner, ajoute la suspension d'apps et le verrou
             des réglages système. Activation explicite par l'utilisateur ;
             supervision toujours visible (aucun usage furtif). -->
        <receiver
            android:name=".service.AdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
